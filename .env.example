# =============================================================================
# Rachar — Contas à Moda do Porto — variáveis de ambiente
# Copia para .env.local e preenche. NUNCA commitar segredos reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Auth.js / NextAuth
# -----------------------------------------------------------------------------
# Segredo para assinar sessões/JWT. Gera um com: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# O AUTH_URL está mais abaixo, junto ao domínio. Estava declarado NOS DOIS
# sítios: aqui comentado com o localhost e lá em baixo activo com o domínio de
# produção — e o de baixo ganhava, o que mandava os redirecionamentos do login
# em local para o site real. Fica num sítio só.

# Allow-list: SÓ estes emails conseguem entrar (separados por vírgula).
# Em dev, se não definires, assume "tiago@example.com,clara@example.com".
ALLOWED_EMAILS="tiago@example.com,clara@example.com"

# AUTH_DEV_LOGIN foi removido: a função que o lia (`isDevLoginEnabled`) já não
# tem chamadores e o botão de "Modo de desenvolvimento" já não existe na página
# de login. Definir esta variável não fazia nada. Em local entra-se com um dos
# emails da allow-list e uma palavra-chave à escolha.

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID / Azure AD (https://portal.azure.com → App registrations)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Issuer: https://login.microsoftonline.com/<TENANT_ID>/v2.0  (ou "common")
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# -----------------------------------------------------------------------------
# Modo de dados
# -----------------------------------------------------------------------------
# "mock"     → repositório em memória (app navegável sem Supabase). Bom para dev.
# "supabase" → usa o Supabase real (requer as chaves abaixo).
# Se não definires, usa "supabase" caso as chaves existam, senão "mock".
APP_DATA_MODE="mock"

# -----------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard → Project Settings → API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key — SÓ no servidor. NUNCA expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Domínio de produção. Em local fica http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://rachar.pt"
# Auth.js: tem de bater certo com o domínio, senão o login redireciona para o
# sítio errado. EM LOCAL, põe http://localhost:3000 — deixar o domínio de
# produção aqui parte o login em desenvolvimento.
AUTH_URL="https://rachar.pt"

# Registo aberto: qualquer pessoa com conta Google se pode registar sozinha.
# Desligado por omissão. Ligar isto muda o produto (traz obrigações de RGPD e
# abre a porta a abuso), por isso é uma decisão explícita.
AUTH_OPEN_REGISTRATION="false"

# Envio de email (recuperação de palavra-chave), via Resend.
RESEND_API_KEY=""
EMAIL_FROM="Rachar <ola@send.rachar.pt>"
EMAIL_REPLY_TO="ola@rachar.pt"

# -----------------------------------------------------------------------------
# Atualização automática das cotações
# -----------------------------------------------------------------------------
# A Vercel corre /api/cron/quotes uma vez por dia (ver vercel.json) para encher
# a cache de cotações depois do fecho. Gera um com: openssl rand -base64 32
# A Vercel envia-o sozinha no cabeçalho se estiver definido no projeto.
#
# OBRIGATÓRIO em produção. Sem ele a rota responde 503 e as cotações deixam de
# se atualizar sozinhas. Antes acontecia o contrário — sem segredo a guarda não
# corria e a rota ficava aberta a quem lhe batesse à porta, com dezenas de
# chamadas externas por pedido. Um segredo vazio é agora uma porta fechada.
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Leitura assistida dos ficheiros de corretora
# -----------------------------------------------------------------------------
# Cada corretora nomeia as colunas como quer, e a deteção por cabeçalhos
# conhecidos só apanha os formatos que já vimos. Com esta chave, quando a
# deteção falha pergunta-se a um modelo que coluna é qual.
#
# O que sobe: o cabeçalho e até 14 linhas de exemplo, com as células truncadas.
# O ficheiro não sobe. O modelo escolhe COLUNAS, não lê valores: a leitura dos
# montantes, a deduplicação e o câmbio continuam no código determinístico.
#
# Sem chave, a funcionalidade não aparece e a importação funciona como antes,
# com deteção automática e mapeamento à mão.
ANTHROPIC_API_KEY=""

# --- Preço dos imóveis, do INE (opcional) --------------------------------
# O preço mediano por m² por concelho, para se poder ver quanto vale um imóvel
# à mediana da zona. A fonte é o INE, que tem API pública e documentada — o
# idealista, que é o relatório que toda a gente conhece, não tem API, e só se lá
# chegava a raspar as páginas: contra os termos deles e a partir no dia em que
# mudassem o HTML.
#
# O código do indicador está aqui e não no código porque o INE renumera as
# séries quando muda a metodologia. CONFIRMA-O na página do indicador do INE
# antes de contar com ele. Se ficar errado, a app diz que não percebeu o que
# recebeu e aponta para esta variável, em vez de mostrar zero concelhos.
#
# Em branco, usa-se o valor por omissão que está no código.
INE_PRECO_M2_VARCD=""

# Substitui o pedido inteiro, para o caso de o indicador precisar de dimensões
# que a app não passa. Em branco, monta-se o URL a partir do varcd acima.
INE_PRECO_M2_URL=""
